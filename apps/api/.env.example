ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]
# If port 5432 is already used by another local Postgres/container, change
# the port here to match (and in whatever `docker run -p` you used).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_sdlc_hub

# Optional. Leave both unset to use deterministic mock agent output (no
# cost, no key needed) — see app/services/ai_generation.py. Set
# ANTHROPIC_API_KEY to turn on real Claude calls for agent runs.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_MAX_TOKENS=4096

# Free-tier alternative to Anthropic — used only if ANTHROPIC_API_KEY above
# is unset. Get a key at https://aistudio.google.com/apikey (Google AI
# Studio's Gemini API key has a real no-cost free tier, unlike Anthropic's
# trial-credit model).
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.6-flash

# Another free-tier alternative — used only if ANTHROPIC_API_KEY and
# GEMINI_API_KEY are both unset. OpenRouter (https://openrouter.ai) fronts
# many providers/models — including several ":free"-suffixed ones with no
# cost — behind one OpenAI-compatible endpoint. Get a key at
# https://openrouter.ai/keys. Only used if a fast reachability check
# confirms it responds — see app/services/ai_generation.py.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=poolside/laguna-s-2.1:free
# Which models carry the ":free" suffix (no cost) changes over time — see
# https://openrouter.ai/models?max_price=0 for what's currently free, and
# pick a plain instruct model over a "reasoning" one (reasoning models can
# burn the whole output-token budget on hidden reasoning tokens before
# ever emitting real content). NOTE: OpenRouter's free models also share
# one account-wide DAILY cap (50 requests/day on an unverified account,
# observed in practice) separate from and much stingier than its
# per-minute limiting — a "429 ... free-models-per-day" error means
# you're out for the day, not that you're calling too fast. Adding a
# small credit balance (openrouter.ai/credits) raises this to 1000/day.

# Another free-tier alternative — used only if ANTHROPIC_API_KEY,
# GEMINI_API_KEY, and OPENROUTER_API_KEY are all unset. NVIDIA's hosted
# "Build" API (https://build.nvidia.com) fronts a catalog of hosted
# models — including large ones with no local GPU needed — behind one
# OpenAI-compatible endpoint. Get a free key from the model's page (e.g.
# https://build.nvidia.com/moonshotai/kimi-k3 — click "Generate API Key").
# Preferred over Ollama below when set, since it's a fast hosted call
# rather than slow local CPU inference (also only used if a fast
# reachability check confirms it responds — this endpoint has been
# observed to hang indefinitely instead of erroring).
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=moonshotai/kimi-k3

# Another free-tier alternative — used only if ANTHROPIC_API_KEY,
# GEMINI_API_KEY, OPENROUTER_API_KEY, and NVIDIA_API_KEY are all unset.
# Hugging Face's Inference Providers router
# (https://huggingface.co/docs/inference-providers) fronts many hosted
# backends (Together, Fireworks, HF's own serverless inference, ...)
# behind one OpenAI-compatible endpoint — several with a free quota. Get a
# token at https://huggingface.co/settings/tokens (a plain read-scope
# token works); pick a model+provider combo at
# https://huggingface.co/models?inference_provider=... A genuinely
# separate quota from OpenRouter's — useful as a fallback on a day
# OpenRouter's daily cap is already exhausted.
# HUGGINGFACE_API_KEY=hf_...
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Ollama local inference (completely free, no API key needed) — used if
# ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, NVIDIA_API_KEY,
# and HUGGINGFACE_API_KEY are all unset. Install Ollama from
# https://ollama.ai, then run 'ollama pull llama3.1:8b' to download a
# model.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
