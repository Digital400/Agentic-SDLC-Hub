ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]
# If port 5432 is already used by another local Postgres/container, change
# the port here to match (and in whatever `docker run -p` you used).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_sdlc_hub

# Optional. Leave both unset to use deterministic mock agent output (no
# cost, no key needed) — see app/services/ai_generation.py. Set
# ANTHROPIC_API_KEY to turn on real Claude calls for agent runs.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_MAX_TOKENS=4096

# Free-tier alternative to Anthropic — used only if ANTHROPIC_API_KEY above
# is unset. Get a key at https://aistudio.google.com/apikey (Google AI
# Studio's Gemini API key has a real no-cost free tier, unlike Anthropic's
# trial-credit model).
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.6-flash
