ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]
# If port 5432 is already used by another local Postgres/container, change
# the port here to match (and in whatever `docker run -p` you used).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_sdlc_hub

# Optional. Leave unset to use deterministic mock agent output (no cost, no
# key needed) — see app/services/ai_generation.py. Set this to turn on real
# Claude calls for agent runs.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_MAX_TOKENS=4096
