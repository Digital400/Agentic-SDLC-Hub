{
  "$schema": "./sdlc-workflow.schema.json",
  "id": "scrum-story-lanes-workflow",
  "name": "Scrum Story Lanes Workflow",
  "version": "0.1.0",
  "description": "Project-level graph for Scrum-style delivery: Requirement Intake through Story Crafting runs once per project exactly like the default SDLC workflow, then hands off to Sprint Planning / Release Planning (lightweight grouping + gating stages) while each approved story gets its own parallel delivery lane — see workflows/scrum-story-lanes-lane-template.json and app/services/story_lane_templates.py. This is a separate, opt-in template: the existing default-sdlc-workflow template and every project already using it are untouched.",
  "startNode": "requirement_intake",
  "statuses": [
    "NOT_STARTED",
    "IN_PROGRESS",
    "WAITING_FOR_REVIEW",
    "APPROVED",
    "NEEDS_CHANGES",
    "REJECTED",
    "BLOCKED",
    "COMPLETED",
    "FAILED"
  ],
  "nodes": [
    {
      "id": "requirement_intake",
      "type": "stage",
      "name": "Requirement Intake",
      "description": "Capture the initial stakeholder request, desired outcome, and any known constraints before analysis begins.",
      "agentKey": "requirement-intake-agent",
      "requiredInputs": ["stakeholder_request"],
      "outputArtifactType": "intake_summary",
      "requiresHumanApproval": true,
      "allowedActions": ["draft", "edit", "submit_for_review", "approve", "reject", "request_changes"],
      "nextNodes": ["problem_discovery"],
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "problem_discovery",
      "type": "stage",
      "name": "Problem Discovery",
      "description": "Investigate the underlying problem, its impact, and constraints, and state it clearly enough to design against.",
      "agentKey": "problem-discovery-agent",
      "requiredInputs": ["intake_summary"],
      "outputArtifactType": "problem_statement",
      "requiresHumanApproval": true,
      "allowedActions": ["draft", "edit", "submit_for_review", "approve", "reject", "request_changes"],
      "nextNodes": ["solution_discovery"],
      "position": { "x": 220, "y": 0 }
    },
    {
      "id": "solution_discovery",
      "type": "stage",
      "name": "Solution Discovery",
      "description": "Explore candidate solution approaches, weigh trade-offs, and recommend one to move forward with.",
      "agentKey": "solution-discovery-agent",
      "requiredInputs": ["problem_statement"],
      "outputArtifactType": "solution_options_doc",
      "requiresHumanApproval": true,
      "allowedActions": ["draft", "edit", "submit_for_review", "approve", "reject", "request_changes"],
      "nextNodes": ["hld"],
      "position": { "x": 440, "y": 0 },
      "fullContentArtifactTypes": ["problem_statement"]
    },
    {
      "id": "hld",
      "type": "stage",
      "name": "High-Level Design",
      "description": "Define the system-level architecture and major components for the chosen solution.",
      "agentKey": "hld-agent",
      "requiredInputs": ["solution_options_doc"],
      "outputArtifactType": "hld_document",
      "requiresHumanApproval": true,
      "allowedActions": ["draft", "edit", "submit_for_review", "approve", "reject", "request_changes"],
      "nextNodes": ["story_crafting"],
      "position": { "x": 660, "y": 0 },
      "fullContentArtifactTypes": ["solution_options_doc"],
      "ragTopK": 8,
      "maxRagTokens": 3000
    },
    {
      "id": "story_crafting",
      "type": "stage",
      "name": "Story Crafting",
      "description": "Break the approved high-level design into implementable stories, either as end-to-end user-value stories (VERTICAL mode) or technical-layer stories (HORIZONTAL mode) — see the story_crafting_mode freeform input.",
      "agentKey": "story-crafting-agent",
      "requiredInputs": ["solution_options_doc", "hld_document"],
      "outputArtifactType": "story_backlog",
      "requiresHumanApproval": true,
      "allowedActions": ["draft", "edit", "submit_for_review", "approve", "reject", "request_changes"],
      "nextNodes": ["sprint_planning"],
      "position": { "x": 880, "y": 0 },
      "fullContentArtifactTypes": ["solution_options_doc", "hld_document"],
      "ragTopK": 6,
      "maxRagTokens": 2500
    },
    {
      "id": "sprint_planning",
      "type": "stage",
      "name": "Sprint Planning",
      "description": "Group approved stories into a sprint and assign owners. A deterministic Markdown summary, not an AI draft — see app/services/sprint_export.py and POST /sprints.",
      "agentKey": "sprint-planning-agent",
      "requiredInputs": ["story_backlog"],
      "outputArtifactType": "sprint_plan",
      "requiresHumanApproval": false,
      "allowedActions": ["draft", "edit", "submit_for_review", "complete"],
      "nextNodes": ["release_planning"],
      "position": { "x": 1100, "y": 0 },
      "fullContentArtifactTypes": ["story_backlog"]
    },
    {
      "id": "release_planning",
      "type": "stage",
      "name": "Release Planning",
      "description": "Confirm every sprint story's delivery lane has reached Release Ready before calling the sprint releasable. A deterministic Markdown summary, not an AI draft — see app/services/release_export.py.",
      "agentKey": "release-planning-agent",
      "requiredInputs": ["sprint_plan"],
      "outputArtifactType": "release_plan",
      "requiresHumanApproval": true,
      "allowedActions": ["draft", "edit", "submit_for_review", "approve", "reject", "request_changes"],
      "nextNodes": ["maintenance"],
      "position": { "x": 1320, "y": 0 }
    },
    {
      "id": "maintenance",
      "type": "stage",
      "name": "Maintenance",
      "description": "Monitor the released change, capture incidents and feedback, and feed learnings back into future intake.",
      "agentKey": "maintenance-agent",
      "requiredInputs": ["release_plan"],
      "outputArtifactType": "maintenance_log",
      "requiresHumanApproval": false,
      "allowedActions": ["draft", "edit", "submit_for_review", "complete"],
      "nextNodes": [],
      "position": { "x": 1540, "y": 0 }
    }
  ],
  "edges": [
    { "id": "e-requirement_intake-problem_discovery", "source": "requirement_intake", "target": "problem_discovery" },
    { "id": "e-problem_discovery-solution_discovery", "source": "problem_discovery", "target": "solution_discovery" },
    { "id": "e-solution_discovery-hld", "source": "solution_discovery", "target": "hld" },
    { "id": "e-hld-story_crafting", "source": "hld", "target": "story_crafting" },
    { "id": "e-story_crafting-sprint_planning", "source": "story_crafting", "target": "sprint_planning" },
    { "id": "e-sprint_planning-release_planning", "source": "sprint_planning", "target": "release_planning" },
    { "id": "e-release_planning-maintenance", "source": "release_planning", "target": "maintenance" }
  ]
}
