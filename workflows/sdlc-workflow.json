{
  "$schema": "./sdlc-workflow.schema.json",
  "id": "default-sdlc-workflow",
  "name": "Default SDLC Workflow",
  "version": "0.1.0",
  "description": "Baseline graph-based SDLC workflow. Each node is a stage that produces an artifact; edges define allowed transitions. This is data, not code — the workflow engine (LangGraph, later) will interpret it.",
  "nodes": [
    {
      "id": "requirements",
      "type": "stage",
      "data": {
        "label": "Requirements",
        "artifactType": "requirements_doc",
        "requiresHumanApproval": true,
        "agentAssisted": true
      },
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "design",
      "type": "stage",
      "data": {
        "label": "Design",
        "artifactType": "design_doc",
        "requiresHumanApproval": true,
        "agentAssisted": true
      },
      "position": { "x": 250, "y": 0 }
    },
    {
      "id": "implementation",
      "type": "stage",
      "data": {
        "label": "Implementation",
        "artifactType": "code_change",
        "requiresHumanApproval": false,
        "agentAssisted": true
      },
      "position": { "x": 500, "y": 0 }
    },
    {
      "id": "testing",
      "type": "stage",
      "data": {
        "label": "Testing",
        "artifactType": "test_report",
        "requiresHumanApproval": true,
        "agentAssisted": true
      },
      "position": { "x": 750, "y": 0 }
    },
    {
      "id": "deployment",
      "type": "stage",
      "data": {
        "label": "Deployment",
        "artifactType": "deployment_record",
        "requiresHumanApproval": true,
        "agentAssisted": false
      },
      "position": { "x": 1000, "y": 0 }
    }
  ],
  "edges": [
    { "id": "e-requirements-design", "source": "requirements", "target": "design" },
    { "id": "e-design-implementation", "source": "design", "target": "implementation" },
    { "id": "e-implementation-testing", "source": "implementation", "target": "testing" },
    { "id": "e-testing-deployment", "source": "testing", "target": "deployment" }
  ]
}
